{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/search-master", "dest": "/api/search-master.js" },
    { "src": "/api/match-catalog", "dest": "/api/match-catalog.js" },
    { "src": "/api/fetch-sheet", "dest": "/api/fetch-sheet.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
